{
  "manifest_version": 3,
  "name": "Zoom REST API Tester",
  "version": "1.0.0",
  "description": "Test Zoom REST APIs with Server-to-Server OAuth authentication",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://zoom.us/*",
    "https://api.zoom.us/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
